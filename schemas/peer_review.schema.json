{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nutdnuy/self-driving-portfolio-skill/schemas/peer_review.schema.json",
  "title": "Peer review and Borda voting result",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "borda", "survivors", "adversarial_challenger", "filtered_out"],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "borda": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "borda_points", "mean_review_score", "review_breakdown"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "borda_points": {"type": "number", "minimum": 0},
          "mean_review_score": {"type": "number", "minimum": 1, "maximum": 5},
          "review_breakdown": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risk_adj_return", "diversification", "robustness"],
            "properties": {
              "risk_adj_return": {"type": "number", "minimum": 1, "maximum": 5},
              "diversification": {"type": "number", "minimum": 1, "maximum": 5},
              "robustness": {"type": "number", "minimum": 1, "maximum": 5}
            }
          }
        }
      }
    },
    "survivors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "adversarial_challenger": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["weights", "won"],
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "won": {"type": "boolean"}
      }
    },
    "filtered_out": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "reason"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
