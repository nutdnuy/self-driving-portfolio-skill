{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Covariance estimate",
  "type": "object",
  "required": ["as_of", "method", "tickers", "covariance"],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "method": {"type": "string", "enum": ["sample", "ewma", "ledoit_wolf"]},
    "tickers": {"type": "array", "items": {"type": "string"}},
    "covariance": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "number"}}
    },
    "shrinkage_intensity": {"type": "number"},
    "condition_number": {"type": "number"},
    "lookback_years": {"type": "number"}
  }
}
