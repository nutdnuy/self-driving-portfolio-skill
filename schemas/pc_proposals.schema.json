{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nutdnuy/self-driving-portfolio-skill/schemas/pc_proposals.schema.json",
  "title": "Portfolio-construction proposals",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "proposals"],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "status", "weights", "metrics", "rationale", "feasible"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["ok", "failed"]},
          "error": {"type": "string"},
          "weights": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expected_return": {"type": "number"},
              "volatility": {"type": "number", "minimum": 0},
              "sharpe": {"type": "number"},
              "max_weight": {"type": "number", "minimum": 0, "maximum": 1},
              "effective_n": {"type": "number", "minimum": 0},
              "diversification_ratio": {"type": "number", "minimum": 0}
            }
          },
          "feasible": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
