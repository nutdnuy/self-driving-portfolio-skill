{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Capital Market Assumptions",
  "type": "object",
  "required": ["as_of", "lookback_years", "regime", "cmas"],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "lookback_years": {"type": "number"},
    "regime": {"type": "string"},
    "cmas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "expected_return", "volatility", "confidence"],
        "properties": {
          "ticker": {"type": "string"},
          "expected_return": {"type": "number"},
          "volatility": {"type": "number"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "regime_tilt": {"type": "number"},
          "memo": {"type": "string"}
        }
      }
    }
  }
}
