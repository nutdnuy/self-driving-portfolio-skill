{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nutdnuy/self-driving-portfolio-skill/schemas/regime.schema.json",
  "title": "Macro regime classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of",
    "data_through",
    "vintage_policy",
    "regime",
    "scores",
    "top1_confidence",
    "top1_confidence_low",
    "indicators",
    "notes"
  ],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "data_through": {"type": "string", "format": "date"},
    "vintage_policy": {
      "type": "string",
      "enum": ["fred_vintage_as_of", "latest_revision_cutoff"]
    },
    "regime": {
      "type": "string",
      "enum": ["expansion", "late_cycle", "recession", "recovery"]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expansion", "late_cycle", "recession", "recovery"],
      "properties": {
        "expansion": {"type": "number", "minimum": 0, "maximum": 1},
        "late_cycle": {"type": "number", "minimum": 0, "maximum": 1},
        "recession": {"type": "number", "minimum": 0, "maximum": 1},
        "recovery": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "top1_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "top1_confidence_low": {"type": "boolean"},
    "indicators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["growth", "inflation", "monetary", "financial_conditions"],
      "properties": {
        "growth": {"type": "number"},
        "inflation": {"type": "number"},
        "monetary": {"type": "number"},
        "financial_conditions": {"type": "number"}
      }
    },
    "notes": {"type": "string", "minLength": 1}
  }
}
