{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Macro regime classification",
  "type": "object",
  "required": ["as_of", "regime", "scores", "indicators", "notes"],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "regime": {"type": "string", "enum": ["expansion", "late_cycle", "recession", "recovery"]},
    "scores": {
      "type": "object",
      "required": ["expansion", "late_cycle", "recession", "recovery"],
      "properties": {
        "expansion":  {"type": "number", "minimum": 0, "maximum": 1},
        "late_cycle": {"type": "number", "minimum": 0, "maximum": 1},
        "recession":  {"type": "number", "minimum": 0, "maximum": 1},
        "recovery":   {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "top1_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "top1_confidence_low": {"type": "boolean"},
    "indicators": {
      "type": "object",
      "properties": {
        "growth": {"type": "number"},
        "inflation": {"type": "number"},
        "monetary": {"type": "number"},
        "financial_conditions": {"type": "number"}
      }
    },
    "notes": {"type": "string"}
  }
}
